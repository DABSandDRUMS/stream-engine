{
  "manifest_version": 3,
  "name": "Stream Engine Apple Music Control",
  "version": "1.0.0",
  "key": "",
  "description": "Control the installed Apple Music web app through Stream Engine native messaging.",
  "minimum_chrome_version": "105",
  "permissions": ["nativeMessaging", "scripting", "alarms"],
  "host_permissions": ["https://music.apple.com/*"],
  "background": {
    "service_worker": "background.js"
  }
}
