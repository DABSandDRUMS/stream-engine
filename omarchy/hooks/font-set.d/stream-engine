#!/bin/bash
# Omarchy font-set hook (PLAN §16.2): tell stream-engine the Omarchy font changed so the UI
# switches fonts right away. `omarchy-hook font-set` runs it with the new font family as $1 and
# the engine emits the event `omarchy.font_set {font}`.
#
# Never fails the hook: without the streamctl CLI or a running engine it does nothing.
command -v streamctl >/dev/null 2>&1 || exit 0
[[ -n ${1:-} ]] || exit 0
timeout 3 streamctl fire omarchy.font_set "font=$1" >/dev/null 2>&1
exit 0
